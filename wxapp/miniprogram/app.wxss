/** app.wxss 全局高定唯美婚礼主题样式 (100% 同步原版高级定制请柬美学) **/
page {
  --primary-color: #8B1E1E;
  --primary-light: #A32929;
  --primary-dark: #6D1414;
  --gold-color: #C5A059;
  --gold-accent: #D4AF37;
  --gold-light: #FBF7EE;
  --bg-color: #FAF7F2;
  --text-main: #2D2522;
  --text-sub: #5C4F4A;
  --text-muted: #8C7B75;
  --border-color: #EBDDCF;
  --card-bg: #FFFFFF;
  
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, "Songti SC", "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
  color: var(--text-main);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

/* 高定白卡纸奢华卡片 (原版白底圆角美学) */
.card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 32rpx;
  margin: 24rpx 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(45, 37, 34, 0.05);
  border: 1rpx solid rgba(225, 215, 205, 0.8);
  position: relative;
  overflow: hidden;
}

/* 典雅烫金双线边框装饰 (微弱温润金线，绝不土俗) */
.gold-frame {
  border: 2rpx solid rgba(197, 160, 89, 0.35);
  position: relative;
}

.gold-frame::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  border: 1rpx solid rgba(197, 160, 89, 0.18);
  pointer-events: none;
  border-radius: inherit;
}

/* 标题规范 (完全复刻原版中英双语宋体字形) */
.section-header,
.section-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 24rpx;
  text-align: center;
}

.section-en,
.title-en {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #A8958E;
  text-transform: uppercase;
  font-style: italic;
  font-family: serif;
}

.section-cn,
.title-cn {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1311;
  letter-spacing: 3rpx;
  margin-top: 8rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.section-divider,
.divider {
  width: 60rpx;
  height: 4rpx;
  background: var(--primary-color);
  margin-top: 16rpx;
  border-radius: 4rpx;
}

/* 高定朱红渐变按钮 */
.btn-primary {
  background: linear-gradient(135deg, #9C2424 0%, #8B1E1E 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(139, 30, 30, 0.22);
  border: none;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.btn-primary:active {
  opacity: 0.92;
  transform: scale(0.99);
}

/* 微信专属绿色官方胶囊按钮 */
.btn-wechat {
  background: #07C160;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.25);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-wechat:active {
  background: #06AD56;
}

/* 浮动飘落花瓣粒子 */
.petals-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 10;
  overflow: hidden;
}

.petal {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background: rgba(220, 80, 80, 0.25);
  border-radius: 50% 0 50% 50%;
  animation: fallDown 10s linear infinite;
}

.petal:nth-child(1) { left: 10%; animation-duration: 8s; animation-delay: 0s; }
.petal:nth-child(2) { left: 35%; animation-duration: 12s; animation-delay: 2s; background: rgba(212, 175, 55, 0.2); }
.petal:nth-child(3) { left: 65%; animation-duration: 9s; animation-delay: 4s; }
.petal:nth-child(4) { left: 85%; animation-duration: 11s; animation-delay: 1s; }

@keyframes fallDown {
  0% {
    top: -40rpx;
    transform: rotate(0deg) translateX(0);
    opacity: 0;
  }
  15% {
    opacity: 0.8;
  }
  85% {
    opacity: 0.8;
  }
  100% {
    top: 105vh;
    transform: rotate(360deg) translateX(80rpx);
    opacity: 0;
  }
}

/* 悬浮音乐播放器球 (高定黑胶火漆唱片质感) */
.floating-music-btn {
  position: fixed;
  top: 140rpx;
  right: 28rpx;
  z-index: 45;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #C5A059;
  box-shadow: 0 6rpx 20rpx rgba(139, 30, 30, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.floating-music-btn.rotating {
  animation: spinBgm 5s linear infinite;
}

.music-disc-inner {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #9C2424 0%, #8B1E1E 60%, #590F0F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 226, 166, 0.6);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
}

.music-symbol {
  font-size: 26rpx;
  color: #F8E2A6;
  font-family: serif;
  transform: translateY(-1rpx);
}

@keyframes spinBgm {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 适配高定悬浮毛玻璃底栏的安全滚动距离 */
.container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx) !important;
  box-sizing: border-box;
}


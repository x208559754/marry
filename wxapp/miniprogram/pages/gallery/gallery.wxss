/* pages/gallery/gallery.wxss - 高定婚纱相册与纪事样式 */
.container {
  padding-bottom: 80rpx;
}

/* 照片瀑布流 / 栅格展卷 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 28rpx;
}

.photo-card {
  width: calc(50% - 10rpx);
  height: 440rpx;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  background: #FAF7F2;
  box-shadow: 0 6rpx 20rpx rgba(45, 37, 34, 0.05);
  border: 1rpx solid rgba(225, 215, 205, 0.7);
}

.photo-card.span-full {
  width: 100%;
  height: 480rpx;
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 20rpx 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
  display: flex;
  flex-direction: column;
}

.p-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  font-family: "Songti SC", "Noto Serif SC", serif;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.p-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 16rpx;
  letter-spacing: 2rpx;
  font-family: serif;
  margin-top: 2rpx;
}

/* 恋爱历程时间轴 */
.story-section {
  padding: 0 28rpx;
}

.timeline-wrap {
  position: relative;
  padding-left: 56rpx;
  margin-top: 36rpx;
}

.timeline-line {
  position: absolute;
  left: 22rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 2rpx;
  background: rgba(225, 215, 205, 0.9);
}

.story-item {
  position: relative;
  margin-bottom: 36rpx;
}

.story-node {
  position: absolute;
  left: -56rpx;
  top: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #8B1E1E;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(139, 30, 30, 0.15);
  z-index: 2;
}

.node-heart {
  color: #8B1E1E;
  font-size: 24rpx;
}

.story-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(45, 37, 34, 0.05);
  border: 1rpx solid rgba(225, 215, 205, 0.8);
}

.story-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.story-date {
  font-size: 20rpx;
  font-weight: 600;
  color: #5C4F4A;
  background: #FAF7F2;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, monospace;
}

.story-tag {
  font-size: 18rpx;
  color: #A8958E;
  font-family: serif;
}

.story-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D2522;
  font-family: "Songti SC", "Noto Serif SC", serif;
  margin-bottom: 12rpx;
}

.story-img {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  display: block;
}

.story-content {
  font-size: 22rpx;
  line-height: 1.8;
  color: #5C4F4A;
  font-family: "Songti SC", "Noto Serif SC", serif;
  display: block;
}

.save-tip {
  text-align: center;
  font-size: 20rpx;
  color: #8C7B75;
  margin-top: 40rpx;
  padding: 0 30rpx;
}

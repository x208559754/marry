/* pages/story/story.wxss */
.container {
  padding-bottom: 80rpx;
}

.story-list {
  padding: 0 10rpx;
}

.story-card {
  margin-bottom: 30rpx;
  position: relative;
}

.story-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: #FFF9E6;
  border: 1rpx solid #E6CA65;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tag-year {
  font-size: 22rpx;
  font-weight: bold;
  color: #B8860B;
}

.story-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sh-icon {
  font-size: 36rpx;
}

.sh-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.story-img {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  margin: 10rpx 0 16rpx;
}

.story-desc {
  font-size: 26rpx;
  color: #4A3E3D;
  line-height: 1.7;
}

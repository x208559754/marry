<!-- pages/story/story.wxml -->
<view class="container theme-{{theme || 'red'}}">
  <view class="section-title">
    <text class="title-cn">我们相遇的故事</text>
    <text class="title-en">OUR LOVE STORY & TIMELINE</text>
    <view class="divider"></view>
  </view>

  <view class="story-list" wx:if="{{storyList.length > 0}}">
    <view wx:for="{{storyList}}" wx:key="index" class="card story-card">
      <view class="story-tag" wx:if="{{item.year || item.date}}">
        <text class="tag-year">{{item.year || item.date}}</text>
      </view>
      <view class="story-head">
        <text class="sh-icon">✦</text>
        <text class="sh-title">{{item.title}}</text>
      </view>
      <video
        wx:if="{{item.image && item.isVideo}}"
        class="story-img"
        src="{{item.image}}"
        object-fit="cover"
        controls="{{true}}"
        show-center-play-btn="{{true}}"
      ></video>
      <image
        wx:elif="{{item.image}}"
        class="story-img"
        src="{{item.image}}"
        mode="aspectFill"
        lazy-load="{{true}}"
      ></image>
      <text class="story-desc">{{item.desc || item.content}}</text>
    </view>
  </view>

  <view class="card story-empty" wx:elif="{{loaded}}">
    <text class="story-empty-text">我们的故事正在慢慢书写，敬请期待</text>
  </view>
</view>

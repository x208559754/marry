<!-- pages/blessings/blessings.wxml - 亲友真挚祝福与留言墙 -->
<view class="container theme-{{theme || 'red'}}">
  <ambient-overlay theme="{{theme || 'red'}}" show-petals="{{true}}" show-danmaku="{{true}}" />
  <view class="section-header">
    <text class="section-en">BLESSINGS & WISHES</text>
    <text class="section-cn">亲友祝福 · 美好寄语</text>
    <view class="section-divider"></view>
  </view>

  <view class="card heart-energy-card">
    <view class="heart-burst-layer">
      <view
        wx:for="{{heartBurst}}"
        wx:key="key"
        class="burst-heart"
        style="left: {{item.left}}%;"
      >♥</view>
    </view>
    <view class="he-title">已收到亲友真挚祝福</view>
    <view class="he-count">
      <text class="he-number">{{heartsCount}}</text>
      <text class="he-unit">条心意</text>
    </view>
    <view class="btn-wrap">
      <view class="btn-send-heart" bindtap="sendHeart" hover-class="btn-send-heart-hover" hover-stay-time="80">
        <text class="heart-icon">♥</text>
        <text>为新人送上新婚祝愿</text>
      </view>
    </view>
  </view>

  <view class="card post-card">
    <view class="post-header">
      <view class="author-info">
        <image class="post-avatar" wx:if="{{guestAvatar}}" src="{{guestAvatar}}" mode="aspectFill"></image>
        <view class="post-avatar-seal" wx:else>囍</view>
        <text class="post-name">{{guestName || '亲朋好友'}}</text>
      </view>
    </view>

    <view class="preset-chips-wrap">
      <view
        wx:for="{{presetBlessings}}"
        wx:key="*this"
        class="preset-chip {{inputContent === item ? 'preset-chip-on' : ''}}"
        bindtap="selectPreset"
        data-text="{{item}}"
      >{{item}}</view>
    </view>

    <view class="input-row">
      <input
        class="bless-input"
        placeholder="写下对新人的真挚新婚祝愿..."
        value="{{inputContent}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendBlessing"
        maxlength="150"
      />
      <view
        class="btn-send-bless {{isSending ? 'btn-send-bless-disabled' : ''}}"
        bindtap="sendBlessing"
        hover-class="btn-send-bless-hover"
        hover-stay-time="80"
      >{{isSending ? '发送中' : '送出祝福'}}</view>
    </view>
  </view>

  <view class="blessings-list" wx:if="{{blessingsList.length}}">
    <view class="bless-card" wx:for="{{blessingsList}}" wx:key="id">
      <view class="bc-head">
        <view class="bc-user">
          <image class="bc-avatar-img" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="bc-avatar-init" wx:else>{{item.author ? item.author[0] : '客'}}</view>
          <text class="bc-author">{{item.author}}</text>
        </view>
        <text class="bc-time">{{item.createdAt || '刚刚'}}</text>
      </view>
      <text class="bc-content">{{item.content}}</text>
      <view class="bc-footer">
        <view class="like-btn" bindtap="likeBlessing" data-id="{{item.id}}">
          <text class="like-heart">♥</text>
          <text class="like-count">{{item.likes || 1}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="bless-empty" wx:else>
    <text class="bless-empty-text">还没有祝福，来写下第一条寄语吧</text>
  </view>

  <view class="bottom-space"></view>
</view>

/* pages/blessings/blessings.wxss */
.container {
  padding-bottom: 80rpx;
  overflow-x: hidden;
}

/* ---------------- 三轨无缝弹幕 ---------------- */
.danmaku-stage {
  margin: 0 28rpx 8rpx;
  height: 236rpx;
  padding: 20rpx 0;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FCF8F1 0%, #F4E9D8 100%);
  border: 1rpx solid rgba(197, 160, 89, 0.32);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 32rpx, #000 calc(100% - 32rpx), transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 32rpx, #000 calc(100% - 32rpx), transparent 100%);
}

.dm-lane {
  height: 60rpx;
  overflow: hidden;
  white-space: nowrap;
  line-height: 0;
  width: 100%;
}

.dm-track {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  height: 60rpx;
  width: max-content;
  animation-name: dm-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.dm-half {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  height: 60rpx;
}

.danmaku-item {
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 52rpx;
  padding: 0 24rpx;
  margin-right: 32rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(197, 160, 89, 0.42);
  box-shadow: 0 2rpx 8rpx rgba(45, 37, 34, 0.05);
  color: #6D1414;
  white-space: nowrap;
}

.dm-author {
  font-size: 22rpx;
  line-height: 52rpx;
  color: #C5A059;
  margin-right: 12rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.dm-text {
  font-size: 24rpx;
  line-height: 52rpx;
  color: #6D1414;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

@keyframes dm-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ---------------- 心意卡片 ---------------- */
.heart-energy-card {
  text-align: center;
  padding: 44rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.heart-burst-layer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 88rpx;
  height: 260rpx;
  pointer-events: none;
  overflow: hidden;
  z-index: 2;
}

.burst-heart {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  margin-left: -20rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #8B1E1E;
  text-align: center;
  animation: heart-rise 1.1s ease-out forwards;
}

@keyframes heart-rise {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  18% { opacity: 1; }
  100% { transform: translateY(-240rpx) scale(1.2); opacity: 0; }
}

.he-title {
  font-size: 22rpx;
  color: #8C7B75;
  margin-bottom: 4rpx;
  line-height: 1.4;
}

.he-count {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 28rpx;
}

.he-number {
  font-size: 54rpx;
  font-weight: 700;
  color: #1A1311;
  line-height: 1.15;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
}

.he-unit {
  font-size: 22rpx;
  color: #A8958E;
  margin-left: 8rpx;
  line-height: 1.15;
}

.btn-wrap {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.btn-send-heart {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 44rpx;
  background: linear-gradient(135deg, #9C2424 0%, #8B1E1E 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 80rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 22rpx rgba(139, 30, 30, 0.25);
}

.btn-send-heart-hover {
  opacity: 0.92;
}

.heart-icon {
  font-size: 26rpx;
  color: #F8E2A6;
  margin-right: 10rpx;
  line-height: 80rpx;
}

/* ---------------- 发布卡片 ---------------- */
.post-card {
  padding: 36rpx 30rpx;
}

.post-header {
  margin-bottom: 20rpx;
}

.author-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.post-avatar,
.post-avatar-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.post-avatar {
  border: 2rpx solid #C5A059;
}

.post-avatar-seal {
  background: #8B1E1E;
  color: #F8E2A6;
  border: 1.5rpx solid #C5A059;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "Noto Serif SC", serif;
  line-height: 1;
}

.post-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2522;
  font-family: "Songti SC", "Noto Serif SC", serif;
  line-height: 1.3;
}

.preset-chips-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 0 20rpx -12rpx;
}

.preset-chip {
  background: #FAF7F2;
  border: 1rpx solid rgba(225, 215, 205, 0.9);
  padding: 10rpx 20rpx;
  margin: 0 0 12rpx 12rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  color: #5C4F4A;
  line-height: 1.4;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.preset-chip-on {
  background: #FFF8EE;
  border-color: #8B1E1E;
  color: #8B1E1E;
}

.input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.bless-input {
  flex: 1;
  min-width: 0;
  background: #FAF7F2;
  border: 1rpx solid rgba(225, 215, 205, 0.9);
  border-radius: 18rpx;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #2D2522;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.btn-send-bless {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 76rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #9C2424 0%, #8B1E1E 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 76rpx;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(139, 30, 30, 0.25);
}

.btn-send-bless-hover {
  opacity: 0.92;
}

.btn-send-bless-disabled {
  opacity: 0.65;
}

/* ---------------- 留言墙 ---------------- */
.blessings-list {
  padding: 0 28rpx;
}

.bless-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 37, 34, 0.04);
  border: 1rpx solid rgba(225, 215, 205, 0.7);
}

.bc-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bc-user {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.bc-avatar-img,
.bc-avatar-init {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.bc-avatar-img {
  border: 1rpx solid #C5A059;
}

.bc-avatar-init {
  background: #FAF4EC;
  border: 1rpx solid #C5A059;
  color: #8B1E1E;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.bc-author {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2522;
  font-family: "Songti SC", "Noto Serif SC", serif;
  line-height: 1.3;
}

.bc-time {
  font-size: 18rpx;
  color: #A8958E;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.3;
}

.bc-content {
  font-size: 26rpx;
  line-height: 1.75;
  color: #5C4F4A;
  font-family: "Songti SC", "Noto Serif SC", serif;
  display: block;
}

.bc-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.like-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 20rpx;
  color: #8B1E1E;
  padding: 6rpx 4rpx;
  line-height: 1;
}

.like-heart {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.bless-empty {
  margin: 8rpx 28rpx 0;
  padding: 56rpx 32rpx;
  text-align: center;
}

.bless-empty-text {
  font-size: 24rpx;
  color: #A8958E;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.bottom-space {
  height: 40rpx;
}

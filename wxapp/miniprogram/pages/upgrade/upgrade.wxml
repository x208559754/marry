<!-- pages/upgrade/upgrade.wxml — 多档套餐对比与购买（套餐来自平台总后台「套餐管理」） -->
<view class="up-page">
  <view class="up-hero">
    <view class="up-seal">囍</view>
    <text class="up-title">{{isCreateMode ? '开通我的专属请柬' : (currentLevel > 0 ? '套餐与权益' : '升级套餐')}}</text>
    <text class="up-sub">{{isCreateMode ? '开通后立即获得独立后台权限 · 微信直接管理' : '按场次购买 · 仅对当前婚礼生效'}}</text>
    <view class="up-status {{premium ? 'up-status-on' : ''}}" wx:if="{{!isCreateMode && !loading && !error}}">
      当前：{{currentName}}{{expiresText ? ' · ' + expiresText + ' 到期' : (premium ? ' · 永久有效' : '')}}{{expired ? ' · 付费套餐已过期' : ''}}
    </view>
    <view class="up-my-pill" wx:if="{{isCreateMode && myWedding}}" bindtap="enterMyWedding">
      已有专属请柬（{{myWedding.groomName}} &amp; {{myWedding.brideName}}）· 直接进后台 ›
    </view>
  </view>

  <view class="up-loading" wx:if="{{loading}}">加载中…</view>
  <view class="up-error" wx:elif="{{error}}">
    <text>{{error}}</text>
    <button class="up-retry" bindtap="load">重试</button>
  </view>

  <block wx:else>
    <view class="up-list">
      <view class="up-couple-card" wx:if="{{isCreateMode}}">
        <view class="up-couple-title">新人姓名（选填，开通后随时可在后台修改）</view>
        <view class="up-couple-inputs">
          <input class="up-couple-input" placeholder="新郎姓名" value="{{groomName}}" bindinput="onGroomInput" maxlength="20" />
          <text class="up-couple-amp">&amp;</text>
          <input class="up-couple-input" placeholder="新娘姓名" value="{{brideName}}" bindinput="onBrideInput" maxlength="20" />
        </view>
      </view>
      <view wx:for="{{plans}}" wx:key="code"
        class="up-card {{item.code === 'free' ? 'up-card-free' : 'up-card-paid'}} {{item.top ? 'up-card-top' : ''}} {{selected === item.code ? 'up-card-on' : ''}} {{item.buyable ? '' : 'up-card-dim'}}"
        bindtap="choose" data-code="{{item.code}}">
        <view class="up-ribbon" wx:if="{{item.current}}">当前套餐</view>
        <view class="up-ribbon up-ribbon-inc" wx:elif="{{item.included}}">已包含</view>
        <view class="up-ribbon up-ribbon-top" wx:elif="{{item.top}}">尊享推荐</view>
        <view class="up-card-head">
          <view class="up-name-wrap">
            <text class="up-plan-name">{{item.name}}</text>
            <text class="up-badge" wx:if="{{item.ent.badge}}">{{item.ent.badge}}</text>
          </view>
          <view class="up-price" wx:if="{{item.priceFen > 0}}">
            <text class="up-yen">¥</text><text class="up-num">{{item.priceText}}</text>
            <text class="up-orig" wx:if="{{item.originalText}}">¥{{item.originalText}}</text>
          </view>
          <text class="up-free-price" wx:else>¥0</text>
        </view>
        <text class="up-per">{{item.periodText}}</text>
        <text class="up-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        <view class="up-feat" wx:for="{{item.features}}" wx:for-item="f" wx:key="*this">
          <text class="{{item.code === 'free' ? 'up-dot' : 'up-check'}}">{{item.code === 'free' ? '·' : '✓'}}</text><text>{{f}}</text>
        </view>
        <view class="up-tags">
          <text class="up-tag">相册 {{item.ent.photos}} 张</text>
          <text class="up-tag {{item.canUploadVideo ? 'up-tag-gold' : ''}}">{{item.canUploadVideo ? '支持上传视频' : '仅支持上传图片'}}</text>
          <text class="up-tag">抽奖 {{item.ent.lotteryPrizes > 0 ? item.ent.lotteryPrizes + ' 个奖项' : '奖项不限'}}</text>
          <text class="up-tag">{{item.ent.lotteryParticipants > 0 ? item.ent.lotteryParticipants + ' 人' : '人数不限'}}</text>
          <text class="up-tag">{{item.ent.lotteryThemes.length}} 套主题</text>
          <text class="up-tag {{item.ent.watermark ? '' : 'up-tag-gold'}}">{{item.ent.watermark ? '含平台标识' : '无平台标识'}}</text>
          <text class="up-tag up-tag-gold" wx:if="{{item.ent.effect === 'petals'}}">花瓣纷飞特效</text>
          <text class="up-tag up-tag-gold" wx:if="{{item.ent.effect === 'gold'}}">金箔流光特效</text>
          <text class="up-tag up-tag-gold" wx:if="{{item.ent.opening}}">专属开场动画</text>
        </view>
        <view class="up-radio" wx:if="{{item.buyable}}"><view class="up-radio-dot" wx:if="{{selected === item.code}}"></view></view>
      </view>
    </view>

    <view class="up-notes">
      <text wx:if="{{isCreateMode}}">· 开通后自动生成专属婚礼请柬，当前微信号自动成为管理员</text>
      <text wx:else>· 开通后立即生效，仅对当前婚礼（{{wid}}）有效</text>
      <text>· 免费版可随时在后台升级更高套餐；升级按新套餐全价计费</text>
      <text>· 支付由微信支付提供，平台不保存任何支付信息</text>
      <text class="up-link" bindtap="contact">· 发票 / 退款 / 其它问题，联系客服 ›</text>
    </view>

    <view class="kefu-card">
      <image class="kefu-card-qr" src="/images/wechat-qr.png" mode="aspectFit" show-menu-by-longpress="true"></image>
      <view class="kefu-card-meta">
        <text class="kefu-card-label">微信客服</text>
        <text class="kefu-card-id">lzx91697</text>
        <text class="kefu-card-hint">长按二维码可识别添加</text>
        <button class="kefu-card-copy" bindtap="copyWechat">复制微信号</button>
      </view>
    </view>
    <view style="height: 180rpx;"></view>
  </block>

  <view class="up-bar" wx:if="{{!loading && !error}}">
    <block wx:if="{{!canBuy}}">
      <button class="up-btn up-btn-done" disabled>{{currentLevel > 0 ? '已是最高套餐 · ' + currentName : '暂无可购买的套餐'}}</button>
    </block>
    <block wx:else>
      <view class="up-bar-price">
        <text class="up-bar-yen">¥</text><text class="up-bar-num">{{priceText}}</text>
        <text class="up-bar-tip">{{selectedPlan.code === 'free' ? '免费版 · 立即开通' : (payMode === 'mock' ? '测试模式·模拟支付' : payMode === 'unavailable' ? '在线支付暂未开通' : selectedPlan.name)}}</text>
      </view>
      <button class="up-btn" bindtap="pay" loading="{{paying}}" disabled="{{paying}}">{{selectedPlan.code === 'free' ? '免费开通请柬' : (payMode === 'unavailable' ? '联系客服开通' : (isCreateMode ? '支付并开通' : (isUpgrade ? '升级到' + selectedPlan.name : '开通' + selectedPlan.name)))}}</button>
    </block>
  </view>

  <view class="kefu-mask" wx:if="{{showKefu}}" catchtap="closeKefu">
    <view class="kefu-sheet" catchtap="noop">
      <text class="kefu-sheet-title">联系客服</text>
      <text class="kefu-sheet-sub">微信扫码添加，或复制微信号</text>
      <image class="kefu-qr" src="/images/wechat-qr.png" mode="aspectFit" show-menu-by-longpress="true"></image>
      <text class="kefu-hint">长按二维码可识别添加</text>
      <text class="kefu-id">微信号 lzx91697</text>
      <button class="kefu-copy" bindtap="copyWechat">复制微信号</button>
      <text class="kefu-close" bindtap="closeKefu">关闭</text>
    </view>
  </view>
</view>

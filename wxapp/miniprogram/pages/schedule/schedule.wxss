/* pages/schedule/schedule.wxss - 高定盛典日程与席设导航样式 */
.container {
  padding-bottom: 80rpx;
}

/* 宴席卡片 */
.venue-card {
  text-align: center;
  padding: 44rpx 32rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.4);
}

.venue-header {
  margin-bottom: 20rpx;
}

.vh-hotel {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1311;
  font-family: "Songti SC", "Noto Serif SC", serif;
  display: block;
}

.vh-hall {
  font-size: 24rpx;
  color: #C5A059;
  font-weight: 600;
  margin-top: 8rpx;
  display: block;
}

.venue-address-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FAF7F2;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin: 24rpx 0 28rpx;
  border: 1rpx solid rgba(225, 215, 205, 0.8);
}

.loc-pin {
  font-size: 28rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 24rpx;
  color: #5C4F4A;
  line-height: 1.5;
}

.nav-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.nav-icon {
  font-size: 28rpx;
}

/* 日程时间轴卡片 */
.timeline-card {
  padding: 40rpx 32rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 36rpx;
  position: relative;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.time-badge {
  flex-shrink: 0;
  width: 110rpx;
  text-align: right;
}

.tb-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #8B1E1E;
  font-family: -apple-system, BlinkMacSystemFont, monospace;
}

.timeline-line {
  position: relative;
  width: 20rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
}

.timeline-line::before {
  content: '';
  position: absolute;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C5A059;
  box-shadow: 0 0 0 4rpx rgba(197, 160, 89, 0.25);
  z-index: 2;
}

.timeline-line::after {
  content: '';
  position: absolute;
  top: 14rpx;
  bottom: -40rpx;
  width: 2rpx;
  background: rgba(225, 215, 205, 0.8);
}

.timeline-item:last-child .timeline-line::after {
  display: none;
}

.timeline-content {
  flex: 1;
  padding-left: 10rpx;
}

.tc-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D2522;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.tc-desc {
  font-size: 22rpx;
  color: #8C7B75;
  margin-top: 6rpx;
  display: block;
}

/* 联络人卡片 */
.contacts-card {
  padding: 34rpx 30rpx;
}

.cc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2522;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.contact-grid {
  display: flex;
  gap: 20rpx;
}

.contact-item {
  flex: 1;
  background: #FAF7F2;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid rgba(225, 215, 205, 0.8);
}

.ci-role {
  font-size: 18rpx;
  color: #8C7B75;
  display: block;
}

.ci-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D2522;
  margin: 6rpx 0 10rpx;
  display: block;
}

.ci-btn {
  font-size: 20rpx;
  color: #8B1E1E;
  font-weight: 600;
}

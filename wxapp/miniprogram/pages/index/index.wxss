/* =========================================================================
   高定中式雅致弹窗：修改尊名称谓 (替代原生丑陋的 wx.showModal)
   ========================================================================= */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 12, 12, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 44rpx;
  box-sizing: border-box;
  animation: modalFadeIn 0.28s ease-out;
}

@keyframes modalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.custom-modal-card {
  width: 100%;
  max-width: 630rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FCF9F5 45%, #F8F2E8 100%);
  border-radius: 36rpx;
  padding: 46rpx 36rpx 40rpx;
  box-shadow: 0 30rpx 70rpx rgba(70, 18, 18, 0.35);
  border: 1.5rpx solid rgba(225, 215, 205, 0.9);
  position: relative;
  box-sizing: border-box;
  animation: modalScaleUp 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes modalScaleUp {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 烫金边框与典雅四角 */
.cmodal-gold-border {
  position: absolute;

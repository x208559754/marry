<!-- pages/admin/admin.wxml -->
<view class="container">
  <view class="card lock-card" wx:if="{{!isAuthorized}}">
    <view class="lock-seal">囍</view>
    <text class="lock-title">新人专属管理后台</text>
    <text class="lock-desc">婚礼新人专属管理后台，实时查看宾客回执与更新相册资料</text>

    <input
      type="password"
      class="pin-input"
      placeholder="请输入管理口令 (默认: 8888)"
      value="{{inputPin}}"
      bindinput="onPinInput"
    />

    <button class="btn-primary unlock-btn" bindtap="verifyPin">
      验证并进入后台
    </button>
  </view>

  <block wx:else>
    <!-- 顶部状态栏与退出 -->
    <view class="admin-top-bar">
      <view class="badge-role">婚礼管理后台</view>
      <text class="exit-link" bindtap="logoutAdmin">退出管理</text>
    </view>

    <!-- 统计看板 -->
    <view class="card stats-card">
      <view class="sc-title">
        <text>宾客回执实时统计</text>
      </view>
      <view class="stats-grid">
        <view class="stat-box">
          <text class="sb-val color-red">{{stats.totalAttendees}}</text>
          <text class="sb-lbl">到场宾客总数</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-green">{{stats.yesCount}}</text>
          <text class="sb-lbl">确认出席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gray">{{stats.noCount}}</text>
          <text class="sb-lbl">遗憾缺席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gold">{{stats.shuttleCount}}</text>
          <text class="sb-lbl">班车接送需求</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换: 宾客名单 / 婚纱照管理 / 系统设置 -->
    <view class="tab-segment">
      <view
        class="tab-item {{curTab === 'guests' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="guests"
      >
        宾客回执 ({{rsvpList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'photos' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="photos"
      >
        相册管理 ({{photosList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'settings' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="settings"
      >
        系统设置
      </view>
    </view>

    <!-- 1. 宾客名单列表 -->
    <view class="tab-pane" wx:if="{{curTab === 'guests'}}">
      <view class="pane-action-bar">
        <text class="pa-title">宾客回执列表</text>
        <button class="btn-mini-refresh" bindtap="loadRsvps" loading="{{loadingRsvps}}">
          刷新数据
        </button>
      </view>

      <view wx:for="{{rsvpList}}" wx:key="id" class="card guest-card">
        <view class="gc-header">
          <view class="gc-name-wrap">
            <text class="gc-name">{{item.name}}</text>
            <text class="gc-status {{item.attending === 'yes' ? 'tag-attend' : 'tag-absent'}}">
              {{item.attending === 'yes' ? '准时出席' : '遗憾缺席'}}
            </text>
          </view>
          <text class="gc-time">{{item.submittedAt || '已记录'}}</text>
        </view>

        <view class="gc-body">
          <view class="gc-row" wx:if="{{item.phone}}" bindtap="callGuest" data-phone="{{item.phone}}">
            <text class="gc-lbl">手机号：</text>
            <text class="gc-phone">{{item.phone}}</text>
            <text class="call-hint">点击拨打</text>
          </view>
          <view class="gc-row" wx:if="{{item.attending === 'yes'}}">
            <text class="gc-lbl">同行人数：</text>
            <text class="gc-val">{{item.guestCount || 1}} 人</text>
            <text class="gc-sep">|</text>
            <text class="gc-lbl">接驳班车：</text>
            <text class="gc-val">{{item.needShuttle ? '需要' : '自驾/自行前往'}}</text>
          </view>
          <view class="gc-row" wx:if="{{item.dietary && item.attending === 'yes'}}">
            <text class="gc-lbl">饮食习惯：</text>
            <text class="gc-val">{{item.dietary}}</text>
          </view>
          <view class="gc-row blessing-row" wx:if="{{item.blessing}}">
            <text class="gc-lbl">祝福寄语：</text>
            <text class="gc-bless">"{{item.blessing}}"</text>
          </view>
        </view>
      </view>

      <view wx:if="{{rsvpList.length === 0}}" class="empty-tip">
        <text>暂无回执提交，宾客在小程序中提交后将实时显现于此</text>
      </view>
    </view>

    <!-- 2. 婚纱照管理与上传 -->
    <view class="tab-pane" wx:if="{{curTab === 'photos'}}">
      <view class="card upload-guide-card">
        <text class="ug-title">上传相片至婚纱相册</text>
        <text class="ug-desc">选取手机相册中的婚纱大片上传，小程序相册与请柬将自动同步更新展示。</text>
        
        <button class="btn-primary ug-btn" bindtap="chooseAndUploadPhoto" loading="{{uploading}}">
          选取并上传婚纱照
        </button>
      </view>

      <view class="photos-manage-grid">
        <view wx:for="{{photosList}}" wx:key="url" class="pm-item">
          <image class="pm-img" src="{{item.url}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item.url}}"></image>
          <view class="pm-caption">
            <text class="pm-title">{{item.title || '婚纱照'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 数据库与列字段设置 -->
    <view class="tab-pane" wx:if="{{curTab === 'settings'}}">
      <!-- 微信登录配置与 jscode2session 调试 -->
      <view class="card notion-status-card" style="margin-bottom: 24rpx;">
        <text class="nsc-title">微信登录与用户解析 (jscode2session)</text>
        <view class="diag-row">
          <text class="diag-label">AppID:</text>
          <text class="diag-val">{{appId}}</text>
        </view>
        <view class="diag-row" style="align-items: center;">
          <text class="diag-label">AppSecret:</text>
          <input
            type="text"
            password
            placeholder="填入小程序 AppSecret"
            value="{{appSecret}}"
            bindinput="onAppSecretInput"
            style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;"
          />
        </view>
        <view class="diag-row" wx:if="{{currentOpenid}}">
          <text class="diag-label">已解析 OpenID:</text>
          <text class="diag-val color-green" style="font-size: 22rpx; word-break: break-all;">{{currentOpenid}}</text>
        </view>
        <view style="display: flex; gap: 16rpx; margin-top: 20rpx;">
          <button class="btn-primary" style="flex: 1; font-size: 26rpx; padding: 16rpx 0;" bindtap="saveAppSecret">保存凭据</button>
          <button class="btn-gold" style="flex: 1; font-size: 26rpx; padding: 16rpx 0;" bindtap="testJscode2Session">测试解析登录</button>
        </view>
        <text class="col-tip">在微信开发者工具调试时请在「详情 - 本地设置」勾选「不校验合法域名」，即可直接通过 https://api.weixin.qq.com/sns/jscode2session 解析用户的 OpenID 与 SessionKey。</text>
      </view>

      <view class="card notion-status-card">
        <text class="nsc-title">云端数据连接状态</text>
        <view class="diag-row">
          <text class="diag-label">Notion API Token:</text>
          <text class="diag-val {{notionStatus.hasApiKey ? 'color-green' : 'color-red'}}">
            {{notionStatus.hasApiKey ? '已配置有效' : '未绑定'}}
          </text>
        </view>
        <view class="diag-row">
          <text class="diag-label">RSVP 回执数据库:</text>
          <text class="diag-val {{notionStatus.rsvpOk ? 'color-green' : 'color-red'}}">
            {{notionStatus.rsvpOk ? '连接成功' : '未连接/需检查权限'}}
          </text>
        </view>
        <view class="diag-row">
          <text class="diag-label">祝福寄语数据库:</text>
          <text class="diag-val {{notionStatus.blessingsOk ? 'color-green' : 'color-red'}}">
            {{notionStatus.blessingsOk ? '连接成功' : '未连接'}}
          </text>
        </view>

        <button class="btn-gold auto-col-btn" bindtap="autoInitColumns" loading="{{initializing}}">
          初始化数据库表格列字段
        </button>
        <text class="col-tip">自动检查并补齐：宾客姓名、手机号、出席状态、同行人数、饮食习惯、接驳车与祝福</text>
      </view>
    </view>
  </block>
</view>

<!-- pages/admin/admin.wxml -->
<view class="container">
  <!-- 非管理员态：展示当前 OpenID + 白名单引导 -->
  <view class="card lock-card" wx:if="{{!isAuthorized}}">
    <view class="lock-seal">囍</view>
    <text class="lock-title">新人专属管理后台</text>
    <text class="lock-desc">管理功能使用微信 OpenID 白名单鉴权：把当前账号的 OpenID 加入服务端白名单后即可进入。</text>

    <view class="diag-row" wx:if="{{currentOpenid}}">
      <text class="diag-label">当前 OpenID:</text>
      <text class="diag-val color-green" style="font-size: 22rpx; word-break: break-all;">{{currentOpenid}}</text>
    </view>
    <view class="diag-row" wx:else>
      <text class="diag-label">登录状态:</text>
      <text class="diag-val color-red">未获取到 OpenID（请检查后端地址与网络）</text>
    </view>

    <button class="btn-primary unlock-btn" bindtap="copyOpenid" wx:if="{{currentOpenid}}">
      复制 OpenID
    </button>
    <button class="btn-gold unlock-btn" bindtap="refreshAdminState" style="margin-top: 16rpx;">
      重新检测权限
    </button>

    <text class="col-tip">本地开发：把上方 OpenID 填入根目录 .dev.vars 的 ADMIN_OPENIDS，重启 wrangler dev 即生效。</text>
    <text class="col-tip">线上：把 OpenID 填入 wrangler.jsonc 的 ADMIN_OPENIDS（或用 wrangler secret put ADMIN_OPENIDS），重新 deploy 即生效。</text>
    <text class="col-tip">当前后端: {{backend}}</text>
  </view>

  <block wx:else>
    <!-- 顶部状态栏与退出 -->
    <view class="admin-top-bar">
      <view class="badge-role">婚礼管理后台</view>
      <text class="exit-link" bindtap="logoutAdmin">退出管理</text>
    </view>

    <!-- 统计看板 -->
    <view class="card stats-card">
      <view class="sc-title">
        <text>宾客回执实时统计</text>
      </view>
      <view class="stats-grid">
        <view class="stat-box">
          <text class="sb-val color-red">{{stats.totalAttendees}}</text>
          <text class="sb-lbl">到场宾客总数</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-green">{{stats.yesCount}}</text>
          <text class="sb-lbl">确认出席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gray">{{stats.noCount}}</text>
          <text class="sb-lbl">遗憾缺席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gold">{{stats.shuttleCount}}</text>
          <text class="sb-lbl">班车接送需求</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换: 宾客名单 / 婚纱照管理 / 婚礼信息 -->
    <view class="tab-segment">
      <view
        class="tab-item {{curTab === 'guests' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="guests"
      >
        宾客回执 ({{rsvpList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'photos' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="photos"
      >
        相册管理 ({{photosList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'settings' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="settings"
      >
        婚礼信息
      </view>
    </view>

    <!-- 1. 宾客名单列表 -->
    <view class="tab-pane" wx:if="{{curTab === 'guests'}}">
      <view class="pane-action-bar">
        <text class="pa-title">宾客回执列表</text>
        <button class="btn-mini-refresh" bindtap="loadRsvps" loading="{{loadingRsvps}}">
          刷新数据
        </button>
      </view>

      <view wx:for="{{rsvpList}}" wx:key="id" class="card guest-card">
        <view class="gc-header">
          <view class="gc-name-wrap">
            <text class="gc-name">{{item.name}}</text>
            <text class="gc-status {{item.attending === 'yes' ? 'tag-attend' : 'tag-absent'}}">
              {{item.attending === 'yes' ? '准时出席' : '遗憾缺席'}}
            </text>
          </view>
          <text class="gc-time">{{item.submittedAt || '已记录'}}</text>
        </view>

        <view class="gc-body">
          <view class="gc-row" wx:if="{{item.phone}}" bindtap="callGuest" data-phone="{{item.phone}}">
            <text class="gc-lbl">手机号：</text>
            <text class="gc-phone">{{item.phone}}</text>
            <text class="call-hint">点击拨打</text>
          </view>
          <view class="gc-row" wx:if="{{item.attending === 'yes'}}">
            <text class="gc-lbl">同行人数：</text>
            <text class="gc-val">{{item.guestCount || 1}} 人</text>
            <text class="gc-sep">|</text>
            <text class="gc-lbl">接驳班车：</text>
            <text class="gc-val">{{item.needShuttle ? '需要' : '自驾/自行前往'}}</text>
          </view>
          <view class="gc-row" wx:if="{{item.dietary && item.attending === 'yes'}}">
            <text class="gc-lbl">饮食习惯：</text>
            <text class="gc-val">{{item.dietary}}</text>
          </view>
          <view class="gc-row blessing-row" wx:if="{{item.blessing}}">
            <text class="gc-lbl">祝福寄语：</text>
            <text class="gc-bless">"{{item.blessing}}"</text>
          </view>
        </view>
      </view>

      <view wx:if="{{rsvpList.length === 0}}" class="empty-tip">
        <text>暂无回执提交，宾客在小程序中提交后将实时显现于此</text>
      </view>
    </view>

    <!-- 2. 婚纱照管理与上传 -->
    <view class="tab-pane" wx:if="{{curTab === 'photos'}}">
      <view class="card upload-guide-card">
        <text class="ug-title">上传相片至婚纱相册</text>
        <text class="ug-desc">选取手机相册中的婚纱大片上传（自动转存图床并登记云端），小程序相册与请柬封面将自动同步更新。</text>

        <button class="btn-primary ug-btn" bindtap="chooseAndUploadPhoto" loading="{{uploading}}">
          选取并上传婚纱照
        </button>
      </view>

      <view class="photos-manage-grid">
        <view wx:for="{{photosList}}" wx:key="url" class="pm-item">
          <image class="pm-img" src="{{item.thumbUrl || item.url}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item.url}}"></image>
          <view class="pm-caption">
            <text class="pm-title">{{item.title || '婚纱照'}}</text>
            <text bindtap="deletePhoto" data-id="{{item.id}}" style="color: #B23A3A; font-size: 24rpx; padding: 4rpx 12rpx;">删除</text>
          </view>
        </view>
      </view>

      <view wx:if="{{photosList.length === 0}}" class="empty-tip">
        <text>相册还是空的，点击上方按钮上传第一张婚纱照</text>
      </view>
    </view>

    <!-- 3. 婚礼信息编辑 -->
    <view class="tab-pane" wx:if="{{curTab === 'settings'}}">
      <view class="card notion-status-card">
        <text class="nsc-title">婚礼信息（保存后全局同步）</text>

        <view class="diag-row">
          <text class="diag-label">新郎姓名:</text>
          <input value="{{configForm.groomName}}" bindinput="onFormInput" data-field="groomName" placeholder="新郎姓名"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">新郎电话:</text>
          <input value="{{configForm.groomPhone}}" bindinput="onFormInput" data-field="groomPhone" placeholder="新郎电话"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">新娘姓名:</text>
          <input value="{{configForm.brideName}}" bindinput="onFormInput" data-field="brideName" placeholder="新娘姓名"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">新娘电话:</text>
          <input value="{{configForm.bridePhone}}" bindinput="onFormInput" data-field="bridePhone" placeholder="新娘电话"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">吉日良辰:</text>
          <input value="{{configForm.date}}" bindinput="onFormInput" data-field="date" placeholder="如 2026年10月18日"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">典礼时间:</text>
          <input value="{{configForm.time}}" bindinput="onFormInput" data-field="time" placeholder="如 11:58"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">酒店名称:</text>
          <input value="{{configForm.venueName}}" bindinput="onFormInput" data-field="venueName" placeholder="酒店/会场名称"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">宴会厅号:</text>
          <input value="{{configForm.venueHall}}" bindinput="onFormInput" data-field="venueHall" placeholder="宴会厅"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">详细地址:</text>
          <input value="{{configForm.venueAddress}}" bindinput="onFormInput" data-field="venueAddress" placeholder="详细地址"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">纬度/经度:</text>
          <input value="{{configForm.venueLat}}" bindinput="onFormInput" data-field="venueLat" placeholder="纬度 如 31.2304" style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
          <input value="{{configForm.venueLng}}" bindinput="onFormInput" data-field="venueLng" placeholder="经度 如 121.4737" style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">新郎联系电话:</text>
          <input value="{{configForm.contactGroom}}" bindinput="onFormInput" data-field="contactGroom" placeholder="宾客拨打用"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>
        <view class="diag-row">
          <text class="diag-label">新娘联系电话:</text>
          <input value="{{configForm.contactBride}}" bindinput="onFormInput" data-field="contactBride" placeholder="宾客拨打用"
                 style="flex: 1; font-size: 24rpx; background: #FAF7F2; padding: 10rpx 16rpx; border-radius: 8rpx; border: 1rpx solid #E6CA65; margin-left: 12rpx;" />
        </view>

        <button class="btn-primary" style="margin-top: 24rpx;" bindtap="saveConfigForm" loading="{{savingConfig}}">
          保存婚礼信息
        </button>
        <text class="col-tip">保存后请到各页面下拉刷新（首页/盛典/流程会自动读取最新配置）。</text>
      </view>

      <view class="card notion-status-card">
        <text class="nsc-title">账号与后端</text>
        <view class="diag-row">
          <text class="diag-label">当前 OpenID:</text>
          <text class="diag-val color-green" style="font-size: 22rpx; word-break: break-all;">{{currentOpenid}}</text>
        </view>
        <view class="diag-row">
          <text class="diag-label">后端地址:</text>
          <text class="diag-val" style="font-size: 22rpx; word-break: break-all;">{{backend}}</text>
        </view>
        <view class="diag-row">
          <text class="diag-label">数据存储:</text>
          <text class="diag-val color-green">Cloudflare D1（图片存 ImgBB）</text>
        </view>

        <button class="btn-gold" style="margin-top: 24rpx;" bindtap="logoutAdmin">
          退出管理账号
        </button>
      </view>
    </view>
  </block>
</view>

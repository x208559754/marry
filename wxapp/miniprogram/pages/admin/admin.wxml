<!-- pages/admin/admin.wxml -->
<view class="container theme-{{lotteryTheme || 'red'}}">
  <!-- 未授权：试用开通（绑手机号 + 设密码）或总管口令 -->
  <view class="card lock-card" wx:if="{{!isAuthorized}}">
    <view class="lock-seal">囍</view>
    <text class="lock-title">开通与登录</text>
    <text class="lock-desc">登录后绑定手机号并设置登录密码，即可使用基础版管理自己的请柬，也可以随时升级。</text>

    <view class="diag-row" wx:if="{{currentOpenid}}">
      <text class="diag-label">当前微信已登录</text>
      <text class="diag-val color-green" style="font-size: 22rpx;">{{accountPhoneBound ? '已绑定 ' + accountPhoneMasked : '尚未绑定手机号'}}</text>
    </view>
    <view class="diag-row" wx:else>
      <text class="diag-label">登录状态:</text>
      <text class="diag-val color-red">{{accountLoading ? '正在登录…' : '未获取到登录态（请检查网络）'}}</text>
    </view>

    <view wx:if="{{currentOpenid && !accountReady}}" class="onboard-block">
      <text class="lock-sub">请绑定手机号，并设置一个登录密码（至少 6 位）。密码是你的账户凭证，以后可用于网页端登录；进入本后台仍以微信登录为准。</text>
      <button class="btn-primary unlock-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{bindingAccount}}">微信一键绑定手机号</button>
      <input class="pin-input" type="number" maxlength="11" placeholder="或手动输入 11 位手机号" value="{{bindPhone}}" bindinput="onBindPhoneInput" />
      <input class="pin-input" password placeholder="{{accountHasPassword ? '已设置过密码，如需修改请再输入' : '设置登录密码（至少 6 位）'}}" value="{{bindPassword}}" bindinput="onBindPasswordInput" />
      <input class="pin-input" password placeholder="再次输入密码" value="{{bindPassword2}}" bindinput="onBindPassword2Input" wx:if="{{!accountHasPassword || bindPassword}}" />
      <button class="btn-gold unlock-btn" bindtap="submitBindManual" loading="{{bindingAccount}}">{{accountPhoneBound ? '保存密码并继续' : '提交手机号与密码'}}</button>
    </view>

    <view wx:if="{{currentOpenid && accountReady}}" class="onboard-block">
      <text class="lock-sub" wx:if="{{accountWeddings.length}}">你已绑定 {{accountPhoneMasked}}，可以选择进入自己的请柬后台。</text>
      <text class="lock-sub" wx:else>你已绑定 {{accountPhoneMasked}}，现在可以开通一场基础版请柬。婚礼标识会自动生成，不用自己填写。</text>
      <view wx:for="{{accountWeddings}}" wx:key="id" class="owned-wid" bindtap="enterOwnedWedding" data-wid="{{item.id}}">
        <text class="owned-name">{{item.groomName || '新郎'}} ＆ {{item.brideName || '新娘'}}</text>
        <text class="owned-id">进入管理 ›</text>
      </view>
      <block wx:if="{{!accountWeddings.length}}">
        <input class="pin-input" placeholder="新郎姓名（可稍后改）" value="{{trialGroom}}" bindinput="onTrialGroomInput" />
        <input class="pin-input" placeholder="新娘姓名（可稍后改）" value="{{trialBride}}" bindinput="onTrialBrideInput" />
        <button class="btn-primary unlock-btn" bindtap="startTrialWedding" loading="{{startingTrial}}">开通基础版并进入</button>
      </block>
    </view>

    <button class="btn-gold unlock-btn" bindtap="refreshAdminState" style="margin-top: 16rpx; background: #EFE9DD; color: #555;">
      刷新登录状态
    </button>

    <view class="diag-divider" style="margin: 36rpx 0; border-top: 1rpx dashed #E5D5BA;"></view>
    <text class="lock-sub">平台总管理员请在下方输入总管口令。</text>
    <view style="margin: 16rpx 0 0;">
      <input class="pin-input" password placeholder="请输入总管口令" bindinput="onPasscodeInput" />
      <button class="btn-primary unlock-btn" bindtap="submitSuperPasscode" loading="{{verifyingPasscode}}">
        验证口令并进入总后台
      </button>
    </view>
  </view>

  <block wx:else>
    <!-- 顶部状态栏与退出 -->
    <view class="admin-top-bar">
      <view class="badge-role">{{isSuperAdmin ? '平台总管理员' : '婚礼管理员'}}</view>
      <view style="display: flex; align-items: center;">
        <text wx:if="{{isSuperAdmin}}" class="preview-link" bindtap="goToPreviewCurrentWedding">进入请柬预览 ›</text>
        <button wx:else class="switch-admin-link" bindtap="openSuperPasscodeModal">切换到总管理员</button>
        <text class="exit-link" bindtap="logoutAdmin" style="margin-left: 20rpx;">{{isSuperAdmin ? '退出管理' : '返回请柬'}}</text>
      </view>
    </view>

    <view class="modal-mask" wx:if="{{showSuperPasscodeModal && !isSuperAdmin}}">
      <view class="modal-card">
        <view class="modal-title">切换到总管理员</view>
        <view class="modal-form-item passcode-field">
          <text class="mf-label">总管口令</text>
          <input class="mf-input" password placeholder="请输入总管口令" value="{{inputPasscode}}" disabled="{{verifyingPasscode}}" confirm-type="done" bindinput="onPasscodeInput" bindconfirm="submitSuperPasscode" />
          <text class="passcode-error" wx:if="{{passcodeError}}">{{passcodeError}}</text>
        </view>
        <view class="modal-btn-row">
          <button class="modal-btn-cancel" bindtap="closeSuperPasscodeModal" disabled="{{verifyingPasscode}}">取消</button>
          <button class="modal-btn-confirm" bindtap="submitSuperPasscode" loading="{{verifyingPasscode}}" disabled="{{verifyingPasscode}}">验证并切换</button>
        </view>
      </view>
    </view>

    <!-- 全平台婚礼调度：仅总管口令验证通过后显示 -->
    <view class="card super-weddings-card" wx:if="{{isSuperAdmin}}">
      <view class="sc-title" style="display: flex; justify-content: space-between; align-items: center;">
        <text>婚礼场次管理</text>
        <view class="btn-pill-create" bindtap="openNewWeddingModal">+ 新建婚礼</view>
      </view>
      
      <picker range="{{weddingOptions}}" range-key="label" value="{{selectedWeddingIndex}}" bindchange="onSelectWedding">
        <view class="wedding-picker-display">
          <text class="wp-label">当前管理婚礼：</text>
          <text class="wp-val">{{currentWeddingDisplay || wid || 'demo (演示婚礼)'}}</text>
          <text class="wp-arrow">切换 ›</text>
        </view>
      </picker>
      <view class="wp-sub-tip">切换场次后，下方回执名单、相册、婚礼信息与二维码将同步联动。</view>
    </view>

    <!-- 当前套餐：名称 / 到期 / 用量 / 已解锁与未解锁的权益（来自平台总后台套餐配置） -->
    <view class="card plan-card plan-tier-{{planTier}}" wx:if="{{planLoaded}}">
      <view class="plan-top" bindtap="goUpgrade">
        <view class="plan-left">
          <view class="plan-line">
            <text class="plan-label">当前套餐</text>
            <text class="plan-badge">{{planName}}</text>
            <text class="plan-vip" wx:if="{{planBadge}}">{{planBadge}}</text>
          </view>
          <text class="plan-desc">{{planExpiryText}}</text>
        </view>
        <view class="plan-cta" wx:if="{{planCanUpgrade}}">{{planPremium ? '升级套餐' : '升级'}}{{planPriceText ? ' ' + planPriceText + (planMultiple ? ' 起' : '') : ''}} ›</view>
        <text class="plan-more" wx:else>查看权益 ›</text>
      </view>
      <view class="plan-usage">
        <view class="pu-row" wx:for="{{planUsage}}" wx:key="key">
          <view class="pu-head"><text>{{item.label}}</text><text class="pu-num {{item.full ? 'pu-full' : ''}}">{{item.text}}</text></view>
          <view class="pu-track"><view class="pu-fill {{item.cls}}" style="width: {{item.pct}}%;"></view></view>
        </view>
        <view class="pu-meta">祝福 / 弹幕 {{planBless}} 条 · 当前主题 {{planThemeName}}</view>
      </view>
      <view class="plan-perks">
        <text wx:for="{{planPerks}}" wx:key="text" class="pp {{item.on ? 'pp-on' : 'pp-off'}}" bindtap="goUpgrade">{{item.on ? '✓ ' : '🔒 '}}{{item.text}}</text>
      </view>
    </view>

    <!-- 统计看板 -->
    <view class="card stats-card">
      <view class="sc-title">
        <text>宾客回执实时统计</text>
      </view>
      <view class="stats-grid">
        <view class="stat-box">
          <text class="sb-val color-red">{{stats.totalAttendees}}</text>
          <text class="sb-lbl">到场宾客总数</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-green">{{stats.yesCount}}</text>
          <text class="sb-lbl">确认出席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gray">{{stats.noCount}}</text>
          <text class="sb-lbl">遗憾缺席 (户)</text>
        </view>
        <view class="stat-box">
          <text class="sb-val color-gold">{{stats.shuttleCount}}</text>
          <text class="sb-lbl">班车接送需求</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换: 宾客名单 / 婚纱照管理 / 婚礼信息 / 现场抽奖 -->
    <view class="tab-segment tab-segment-4">
      <view
        class="tab-item {{curTab === 'guests' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="guests"
      >
        宾客回执 ({{rsvpList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'photos' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="photos"
      >
        相册管理 ({{photosList.length}})
      </view>
      <view
        class="tab-item {{curTab === 'settings' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="settings"
      >
        婚礼信息
      </view>
      <view
        class="tab-item {{curTab === 'lottery' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="lottery"
      >
        现场抽奖
      </view>
    </view>

    <!-- 1. 宾客名单列表 -->
    <view class="tab-pane" wx:if="{{curTab === 'guests'}}">
      <view class="pane-action-bar">
        <text class="pa-title">宾客回执列表</text>
        <button class="btn-mini-refresh" bindtap="loadRsvps" loading="{{loadingRsvps}}">
          刷新数据
        </button>
      </view>

      <view wx:for="{{rsvpList}}" wx:key="id" class="card guest-card">
        <view class="gc-header">
          <view class="gc-name-wrap">
            <text class="gc-name">{{item.name}}</text>
            <text class="gc-status {{item.attending === 'yes' ? 'tag-attend' : 'tag-absent'}}">
              {{item.attending === 'yes' ? '准时出席' : '遗憾缺席'}}
            </text>
          </view>
          <text class="gc-time">{{item.submittedAt || '已记录'}}</text>
        </view>

        <view class="gc-body">
          <view class="gc-row" wx:if="{{item.phone}}" bindtap="callGuest" data-phone="{{item.phone}}">
            <text class="gc-lbl">手机号：</text>
            <text class="gc-phone">{{item.phone}}</text>
            <text class="call-hint">点击拨打</text>
          </view>
          <view class="gc-row" wx:if="{{item.attending === 'yes'}}">
            <text class="gc-lbl">同行人数：</text>
            <text class="gc-val">{{item.guestCount || 1}} 人</text>
            <text class="gc-sep">|</text>
            <text class="gc-lbl">接驳班车：</text>
            <text class="gc-val">{{item.needShuttle ? '需要' : '自驾/自行前往'}}</text>
          </view>
          <view class="gc-row" wx:if="{{item.dietary && item.attending === 'yes'}}">
            <text class="gc-lbl">饮食习惯：</text>
            <text class="gc-val">{{item.dietary}}</text>
          </view>
          <view class="gc-row blessing-row" wx:if="{{item.blessing}}">
            <text class="gc-lbl">祝福寄语：</text>
            <text class="gc-bless">"{{item.blessing}}"</text>
          </view>
        </view>
      </view>

      <view wx:if="{{rsvpList.length === 0}}" class="empty-tip">
        <text>暂无回执提交，宾客在小程序中提交后将实时显现于此</text>
      </view>
    </view>

    <!-- 2. 婚纱照管理与上传 -->
    <view class="tab-pane" wx:if="{{curTab === 'photos'}}">
      <view class="card upload-guide-card">
        <text class="ug-title">{{canUploadVideo ? '上传照片和视频' : '上传照片'}}</text>
        <text class="ug-desc" wx:if="{{planLoaded && !canUploadVideo}}">当前套餐仅支持上传图片。</text>
        <text class="ug-desc" wx:if="{{albumPhotoLimit}}">相册 {{photosList.length}} / {{albumPhotoLimit}} 张</text>

        <button class="btn-primary ug-btn" bindtap="chooseAndUploadPhoto" loading="{{uploading}}" disabled="{{movingPhoto || photoDragId}}">
          {{canUploadVideo ? '选取并上传照片或视频' : '选取并上传照片'}}
        </button>
        <button wx:if="{{canUploadVideo}}" class="btn-primary ug-btn ug-btn-gap" bindtap="chooseAndUploadVideo" loading="{{uploadingVideo}}" disabled="{{uploading || movingPhoto || photoDragId}}">
          选取并上传视频
        </button>
        <text class="ug-progress" wx:if="{{uploadingVideo}}">视频上传中 {{uploadProgress}}%</text>
      </view>

      <text wx:if="{{photosList.length > 1}}" class="pm-reorder-tip">{{movingPhoto ? '正在保存顺序…' : '长按照片拖动排序'}}</text>
      <view class="photos-manage-grid"
        catchtouchmove="{{photoDragId ? 'trackPhotoDrag' : ''}}"
        bindtouchend="finishPhotoDrag"
        bindtouchcancel="cancelPhotoDrag"
      >
        <view wx:for="{{photosList}}" wx:key="id" class="pm-item {{photoDragId === item.id ? 'pm-drag-source' : ''}} {{photoDropId === item.id ? 'pm-drop-target' : ''}}">
          <view class="pm-thumb" bindtap="previewPhoto" bindtouchstart="rememberPhotoTouch" bindlongpress="beginPhotoDrag" data-id="{{item.id}}" data-url="{{item.url}}" data-kind="{{item.kind}}">
            <image class="pm-img" src="{{item.thumb_url || item.thumbUrl || item.url}}" mode="aspectFill"></image>
            <view class="pm-play" wx:if="{{item.isVideo || item.kind === 'video'}}">▶</view>
          </view>
          <view class="pm-caption">
            <text class="pm-title">{{item.title || '婚纱照'}}</text>
            <button class="pm-delete" bindtap="deletePhoto" data-id="{{item.id}}" disabled="{{movingPhoto || photoDragId}}">删除</button>
          </view>
        </view>
      </view>
      <image wx:if="{{photoDragPreview}}" class="pm-drag-preview"
        src="{{photoDragPreview.src}}" mode="aspectFill"
        style="width: {{photoDragPreview.width}}px; transform: translate3d({{photoDragPreview.x}}px, {{photoDragPreview.y}}px, 0);"
      ></image>

      <view wx:if="{{photosList.length === 0}}" class="empty-tip">
        <text>{{canUploadVideo ? '相册还是空的，点击上方按钮上传照片或视频' : '相册还是空的，点击上方按钮上传第一张照片'}}</text>
      </view>

      <!-- 岁月印记 · 恋爱纪事（存于婚礼配置 story 字段） -->
      <view class="card record-card">
        <view class="rc-head">
          <text class="ug-title rc-title">岁月印记 · 恋爱纪事</text>
          <text class="rc-status {{storyDirty ? 'rc-status-dirty' : (storyCloudSaved ? 'rc-status-ok' : '')}}">{{storyDirty ? '有未保存修改' : (storyCloudSaved ? '已保存到云端' : '尚未配置，宾客端不显示')}}</text>
        </view>
        <text class="ug-desc rc-desc">这里的纪事会显示在婚纱相册页「岁月印记」时间轴，也会显示在「我们相遇的故事」页。尚未保存时，宾客端不显示任何纪事；保存后只显示这里的列表。</text>

        <view wx:for="{{storyList}}" wx:key="id" class="record-item">
          <view wx:if="{{item.image}}" class="ri-thumb-wrap">
            <video wx:if="{{item.isVideo}}" class="ri-thumb" src="{{item.image}}" object-fit="cover" muted="{{true}}" controls="{{false}}" show-center-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-play-btn="{{false}}"></video>
            <image wx:else class="ri-thumb" src="{{item.image}}" mode="aspectFill"></image>
            <view class="ri-play" wx:if="{{item.isVideo}}">▶</view>
          </view>
          <view wx:else class="ri-thumb ri-thumb-empty"><text>无配图</text></view>
          <view class="ri-body">
            <view class="ri-line">
              <text class="ri-tag" wx:if="{{item.date}}">{{item.date}}</text>
              <text class="ri-title">{{item.title || '（未填标题）'}}</text>
            </view>
            <text class="ri-content">{{item.content || '（未填内容）'}}</text>
            <view class="ri-actions">
              <view class="ri-act {{index === 0 ? 'ri-act-disabled' : ''}}" bindtap="moveStoryItem" data-index="{{index}}" data-dir="-1">上移</view>
              <view class="ri-act {{index === storyList.length - 1 ? 'ri-act-disabled' : ''}}" bindtap="moveStoryItem" data-index="{{index}}" data-dir="1">下移</view>
              <view class="ri-act" bindtap="openStoryModal" data-index="{{index}}">编辑</view>
              <view class="ri-act ri-act-danger" bindtap="deleteStoryItem" data-index="{{index}}">删除</view>
            </view>
          </view>
        </view>

        <view wx:if="{{storyList.length === 0}}" class="empty-tip record-empty">
          <text>{{storyCloudSaved ? '已保存为空列表，宾客端不显示纪事' : '还没有自定义纪事，可新增或载入示例再改'}}</text>
        </view>

        <view class="rc-btn-row">
          <view class="rc-btn rc-btn-gold" bindtap="openStoryModal">＋ 新增纪事</view>
          <view class="rc-btn rc-btn-gold" bindtap="loadSampleStories">载入示例再改</view>
        </view>
        <button class="btn-primary rc-save-btn" bindtap="saveStories" loading="{{savingStory}}">保存岁月印记</button>
        <view class="col-tip" wx:if="{{storyDirty}}"><text>修改尚未保存，宾客端暂不变化。</text><text class="rc-link" bindtap="discardStoryChanges">放弃修改</text></view>
        <text class="col-tip" wx:else>删除纪事只会从列表移除，不会删除相册里的照片。</text>
      </view>
    </view>

    <!-- 3. 婚礼信息编辑 -->
    <view class="tab-pane" wx:if="{{curTab === 'settings'}}">
      <view class="card info-card">
        <view class="info-head">
          <text class="info-title">婚礼信息</text>
          <text class="info-sub">保存后，请柬各页将同步更新</text>
        </view>

        <view class="info-section">
          <view class="info-sec-title">
            <view class="info-sec-line"></view>
            <text>新人</text>
            <view class="info-sec-line"></view>
          </view>
          <view class="info-pair">
            <view class="info-field">
              <text class="info-label">新郎</text>
              <input class="info-input" value="{{configForm.groomName}}" bindinput="onFormInput" data-field="groomName" placeholder="姓名" placeholder-class="info-ph" />
              <input class="info-input" value="{{configForm.groomPhone}}" bindinput="onFormInput" data-field="groomPhone" placeholder="电话（选填）" placeholder-class="info-ph" type="number" maxlength="13" />
            </view>
            <view class="info-field">
              <text class="info-label">新娘</text>
              <input class="info-input" value="{{configForm.brideName}}" bindinput="onFormInput" data-field="brideName" placeholder="姓名" placeholder-class="info-ph" />
              <input class="info-input" value="{{configForm.bridePhone}}" bindinput="onFormInput" data-field="bridePhone" placeholder="电话（选填）" placeholder-class="info-ph" type="number" maxlength="13" />
            </view>
          </view>
        </view>

        <view class="info-section">
          <view class="info-sec-title">
            <view class="info-sec-line"></view>
            <text>典礼</text>
            <view class="info-sec-line"></view>
          </view>
          <view class="info-pair">
            <view class="info-field">
              <text class="info-label">婚礼日期</text>
              <picker mode="date" value="{{configForm.dateISO}}" start="2024-01-01" end="2036-12-31" bindchange="onFormDateChange">
                <view class="info-picker {{configForm.date ? '' : 'is-ph'}}">
                  <text>{{configForm.date || '请选择日期'}}</text>
                  <text class="info-chevron">›</text>
                </view>
              </picker>
            </view>
            <view class="info-field">
              <text class="info-label">典礼时间</text>
              <picker mode="time" value="{{configForm.timeISO}}" bindchange="onFormTimeChange">
                <view class="info-picker {{configForm.time ? '' : 'is-ph'}}">
                  <text>{{configForm.time || '请选择时间'}}</text>
                  <text class="info-chevron">›</text>
                </view>
              </picker>
            </view>
          </view>
        </view>

        <view class="info-section">
          <view class="info-sec-title">
            <view class="info-sec-line"></view>
            <text>场地</text>
            <view class="info-sec-line"></view>
          </view>
          <view class="info-field info-field-full">
            <text class="info-label">酒店 / 会场</text>
            <input class="info-input" value="{{configForm.venueName}}" bindinput="onFormInput" data-field="venueName" placeholder="请填写会场名称" placeholder-class="info-ph" />
          </view>
          <view class="info-field info-field-full">
            <text class="info-label">宴会厅</text>
            <input class="info-input" value="{{configForm.venueHall}}" bindinput="onFormInput" data-field="venueHall" placeholder="宴会厅名称（选填）" placeholder-class="info-ph" />
          </view>
          <view class="info-field info-field-full">
            <text class="info-label">详细地址</text>
            <input class="info-input" value="{{configForm.venueAddress}}" bindinput="onFormInput" data-field="venueAddress" placeholder="用于宾客导航" placeholder-class="info-ph" />
          </view>
          <view class="info-field info-field-full">
            <text class="info-label">地图导航（选填）</text>
            <view class="info-map">
              <view class="info-map-vals">
                <text wx:if="{{configForm.venueLat && configForm.venueLng}}" class="info-coord">{{configForm.venueLat}}，{{configForm.venueLng}}</text>
                <text wx:else class="info-coord is-ph">尚未选点，宾客将无法一键导航</text>
              </view>
              <view class="info-map-btn" bindtap="chooseVenueLocation">地图选点</view>
            </view>
          </view>
        </view>

        <view class="info-section">
          <view class="info-sec-title">
            <view class="info-sec-line"></view>
            <text>宾客联络</text>
            <view class="info-sec-line"></view>
          </view>
          <text class="info-hint">请柬上「联系新人」将拨打这里的号码</text>
          <view class="info-pair">
            <view class="info-field">
              <text class="info-label">新郎</text>
              <input class="info-input" value="{{configForm.contactGroom}}" bindinput="onFormInput" data-field="contactGroom" placeholder="电话" placeholder-class="info-ph" type="number" maxlength="13" />
            </view>
            <view class="info-field">
              <text class="info-label">新娘</text>
              <input class="info-input" value="{{configForm.contactBride}}" bindinput="onFormInput" data-field="contactBride" placeholder="电话" placeholder-class="info-ph" type="number" maxlength="13" />
            </view>
          </view>
        </view>

        <button class="btn-primary info-save" bindtap="saveConfigForm" loading="{{savingConfig}}">保存婚礼信息</button>

        <view class="music-card" wx:if="{{musicLoaded}}">
          <text class="info-title">背景音乐</text>
          <text class="col-tip" wx:if="{{musicEntitled}}">高级功能：上传后，打开小程序就会播放这首。当前播放：{{musicPlayingTitle}}{{musicHasCustom ? '（本场自定义）' : '（平台默认）'}}</text>
          <text class="col-tip" wx:else>当前播放平台默认曲《{{musicDefaultTitle}}》。自定义背景音乐是高级功能，升级后即可上传自己的音乐。</text>
          <input class="info-input" wx:if="{{musicEntitled}}" value="{{musicTitle}}" bindinput="onMusicTitleInput" placeholder="歌曲名称（选填）" placeholder-class="info-ph" />
          <button class="btn-gold unlock-btn" bindtap="chooseAndUploadMusic" loading="{{uploadingMusic}}">{{musicEntitled ? (musicHasCustom ? '重新上传背景音乐' : '上传背景音乐') : '升级后上传自己的音乐'}}</button>
          <view class="ug-progress" wx:if="{{uploadingMusic}}">正在上传 {{musicProgress}}%</view>
          <button class="btn-gold unlock-btn" style="margin-top: 16rpx; background: #EFE9DD; color: #555;" bindtap="restoreDefaultMusic" wx:if="{{musicEntitled && musicHasCustom}}">恢复为平台默认音乐</button>
        </view>
        <text class="col-tip">保存后请到各页面下拉刷新，即可看到最新内容。</text>
      </view>

      <!-- 婚礼当日行程（存于婚礼配置 schedule 字段） -->
      <view class="card record-card">
        <view class="rc-head">
          <text class="nsc-title rc-title">婚礼当日行程</text>
          <text class="rc-status {{scheduleDirty ? 'rc-status-dirty' : (scheduleCloudSaved ? 'rc-status-ok' : '')}}">{{scheduleDirty ? '有未保存修改' : (scheduleCloudSaved ? '已保存到云端' : '尚未配置，宾客端不显示')}}</text>
        </view>
        <text class="ug-desc rc-desc">显示在「盛典日程安排」页的时间轴。尚未保存时，宾客端不显示行程；保存后只显示这里的列表。</text>

        <view wx:for="{{scheduleList}}" wx:key="id" class="record-item">
          <view class="ri-time"><text>{{item.time || '--:--'}}</text></view>
          <view class="ri-body">
            <text class="ri-title">{{item.title || '（未填环节）'}}</text>
            <text class="ri-content" wx:if="{{item.desc}}">{{item.desc}}</text>
            <view class="ri-actions">
              <view class="ri-act {{index === 0 ? 'ri-act-disabled' : ''}}" bindtap="moveScheduleItem" data-index="{{index}}" data-dir="-1">上移</view>
              <view class="ri-act {{index === scheduleList.length - 1 ? 'ri-act-disabled' : ''}}" bindtap="moveScheduleItem" data-index="{{index}}" data-dir="1">下移</view>
              <view class="ri-act" bindtap="openScheduleModal" data-index="{{index}}">编辑</view>
              <view class="ri-act ri-act-danger" bindtap="deleteScheduleItem" data-index="{{index}}">删除</view>
            </view>
          </view>
        </view>

        <view wx:if="{{scheduleList.length === 0}}" class="empty-tip record-empty">
          <text>{{scheduleCloudSaved ? '已保存为空列表，宾客端显示“敬请期待”' : '还没有自定义行程，可新增或载入示例再改'}}</text>
        </view>

        <view class="rc-btn-row">
          <view class="rc-btn rc-btn-gold" bindtap="openScheduleModal">＋ 新增行程</view>
          <view class="rc-btn rc-btn-gold" bindtap="loadSampleSchedule">载入示例再改</view>
        </view>
        <button class="btn-primary rc-save-btn" bindtap="saveSchedule" loading="{{savingSchedule}}">保存当日行程</button>
        <view class="col-tip" wx:if="{{scheduleDirty}}"><text>修改尚未保存，宾客端暂不变化。</text><text class="rc-link" bindtap="discardScheduleChanges">放弃修改</text></view>
        <text class="col-tip" wx:else>与上方「保存婚礼信息」互不覆盖。</text>
      </view>

      <view class="card notion-status-card" style="margin-bottom: 24rpx;">
        <text class="nsc-title">我的婚礼二维码（宾客扫码进入）</text>
        <view class="diag-row">
          <text class="diag-label">婚礼标识:</text>
          <text class="diag-val color-green" style="font-size: 22rpx;">{{wid}}</text>
          <text bindtap="copyWid" style="color: #B23A3A; font-size: 24rpx; padding: 4rpx 16rpx;">复制</text>
        </view>
        <view style="display: flex; gap: 12rpx; margin-top: 16rpx;">
          <button class="qr-env-btn {{qrEnv === 'release' ? 'btn-primary' : 'btn-gold'}}" bindtap="switchQrEnv" data-env="release">正式版码</button>
          <button class="qr-env-btn {{qrEnv === 'trial' ? 'btn-primary' : 'btn-gold'}}" bindtap="switchQrEnv" data-env="trial">体验版码</button>
          <button class="qr-env-btn {{qrEnv === 'develop' ? 'btn-primary' : 'btn-gold'}}" bindtap="switchQrEnv" data-env="develop">开发版码</button>
        </view>
        <view style="display: flex; justify-content: center; margin-top: 20rpx;">
          <image wx:if="{{qrSrc}}" src="{{qrSrc}}" style="width: 360rpx; height: 360rpx; border-radius: 16rpx; background: #FFFFFF;" mode="aspectFit" show-menu-by-longpress="{{true}}" binderror="onQrError"></image>
        </view>
        <text class="col-tip" wx:if="{{qrError}}">{{qrError}}</text>
        <text class="col-tip">长按二维码可保存到相册；把二维码发给亲友，扫码即可进入你们的专属请柬。</text>
      </view>

      <view class="card notion-status-card">
        <text class="nsc-title">账号与后端</text>
        <view class="diag-row">
          <text class="diag-label">当前 OpenID:</text>
          <text class="diag-val color-green" style="font-size: 22rpx; word-break: break-all;">{{currentOpenid}}</text>
        </view>
        <view class="diag-row">
          <text class="diag-label">后端地址:</text>
          <text class="diag-val" style="font-size: 22rpx; word-break: break-all;">{{backend}}</text>
        </view>
        <view class="diag-row">
          <text class="diag-label">数据存储:</text>
          <text class="diag-val color-green">Cloudflare D1（图片存 ImgBB）</text>
        </view>

        <button class="btn-gold" style="margin-top: 24rpx;" bindtap="logoutAdmin">
          退出管理账号
        </button>
      </view>
    </view>

    <!-- 4. 现场抽奖（数据存 lotteries 表，与婚礼信息互不覆盖） -->
    <view class="tab-pane lt-pane lt-th-{{lotteryTheme}}" wx:if="{{curTab === 'lottery'}}">
      <!-- 抽奖大屏（随所选主题变色） -->
      <view class="lt-hero">
        <view class="lt-hero-deco lt-hero-deco-a"></view>
        <view class="lt-hero-deco lt-hero-deco-b"></view>
        <view class="lt-hero-top">
          <view class="lt-hero-mark">囍</view>
          <view class="lt-hero-tt">
            <text class="lt-hero-kicker">LUCKY DRAW · {{lotteryThemeName}}</text>
            <text class="lt-hero-title">幸运抽奖</text>
          </view>
          <view class="lt-hero-status {{lotteryStatus === 'rolling' ? 'lt-hero-status-live' : ''}}">
            <view class="lt-dot"></view><text>{{lotteryStatusShort}}</text>
          </view>
        </view>
        <text class="lt-hero-line">{{lotteryStatusText}}</text>
        <view class="lt-stats">
          <view class="lt-stat"><text class="lt-stat-n">{{lotteryPrizes.length}}</text><text class="lt-stat-l">奖项</text></view>
          <view class="lt-stat"><text class="lt-stat-n">{{lotteryParticipants.length}}</text><text class="lt-stat-l">参与人</text></view>
          <view class="lt-stat"><text class="lt-stat-n">{{lotteryRemaining}}</text><text class="lt-stat-l">剩余可抽</text></view>
        </view>
        <view class="lt-url" bindtap="copyLotteryUrl"><text selectable="{{true}}">{{lotteryUrl}}</text></view>
        <view class="lt-hero-btns">
          <view class="lt-hero-btn lt-hero-btn-main" bindtap="copyLotteryUrl">复制大屏网址</view>
          <view class="lt-hero-btn" bindtap="loadLottery">刷新状态</view>
        </view>
        <text class="lt-hero-tip">在电脑或投影仪浏览器打开网址并全屏（双击画面或点右下角「全屏」）；大屏只负责展示，开奖都在这里操作。</text>
      </view>

      <!-- 婚礼与大屏主题 -->
      <view class="card record-card">
        <view class="rc-head">
          <text class="ug-title rc-title">婚礼与大屏主题</text>
          <text class="rc-status rc-status-ok">{{lotteryThemeName}}</text>
        </view>
        <text class="ug-desc rc-desc">选好后，请柬首页、相册、日程、回执、祝福页及现场抽奖大屏将同步切换为同一主题配色。</text>
        <view class="lt-themes">
          <view wx:for="{{lotteryThemes}}" wx:key="key" class="lt-theme {{item.key === lotteryTheme ? 'lt-theme-on' : ''}} {{item.locked ? 'lt-theme-locked' : ''}}" bindtap="chooseLotteryTheme" data-key="{{item.key}}" data-locked="{{item.locked ? 1 : ''}}">
            <view class="lt-swatch" style="background: {{item.bg}};">
              <text class="lt-swatch-mark" style="color: {{item.mark}}; border-color: {{item.mark}};">囍</text>
              <view class="lt-swatch-bar" style="background: {{item.mark}};"></view>
              <view class="lt-swatch-dots">
                <view class="lt-swatch-dot" style="background: {{item.mark}};"></view>
                <view class="lt-swatch-dot" style="background: {{item.mark}};"></view>
                <view class="lt-swatch-dot" style="background: {{item.mark}};"></view>
              </view>
              <view class="lt-swatch-check" wx:if="{{item.key === lotteryTheme}}">✓</view>
              <view class="lt-swatch-lock" wx:if="{{item.locked}}">高级版</view>
            </view>
            <text class="lt-theme-name">{{item.name}}</text>
            <text class="lt-theme-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 奖项与开奖 -->
      <view class="card record-card">
        <view class="rc-head">
          <text class="ug-title rc-title">奖项与开奖</text>
          <text class="rc-status">剩余可抽 {{lotteryRemaining}} 人</text>
        </view>
        <text class="ug-desc rc-desc">奖品可以是红包金额，也可以是礼物，自由填写。点「开始抽奖」后由服务器随机抽出中奖人，大屏滚动约 5 秒后揭晓；每人本场最多中奖一次。</text>

        <view wx:for="{{lotteryPrizes}}" wx:key="id" class="record-item lt-prize {{item.onScreen ? 'lt-prize-on' : ''}}">
          <view class="ri-time lt-count"><text>{{item.count}} 名</text></view>
          <view class="ri-body">
            <view class="ri-line">
              <text class="ri-title">{{item.label}}</text>
              <text class="lt-tag lt-tag-live" wx:if="{{item.rolling}}">抽奖中</text>
              <text class="lt-tag" wx:elif="{{item.onScreen}}">大屏展示中</text>
            </view>
            <text class="ri-content" wx:if="{{item.sub}}">{{item.sub}}</text>
            <view class="lt-winners" wx:if="{{item.drawn && !item.rolling}}">
              <text class="lt-w-label">中奖（{{item.winnerCount}}）</text><text class="lt-w-names">{{item.winnersText}}</text>
            </view>
            <view class="lt-winners lt-winners-wait" wx:elif="{{item.rolling}}">
              <text>大屏滚动中，到时自动揭晓</text>
            </view>

            <view class="lt-ctrl-row">
              <button wx:if="{{item.rolling}}" class="lt-ctrl lt-ctrl-primary" bindtap="revealNow" disabled="{{lotteryBusy}}">立即开奖</button>
              <button wx:elif="{{!item.drawn}}" class="lt-ctrl lt-ctrl-primary" bindtap="startPrizeDraw" data-id="{{item.id}}" disabled="{{lotteryBusy || lotteryStatus === 'rolling'}}">开始抽奖</button>
              <button wx:else class="lt-ctrl lt-ctrl-gold" bindtap="redrawPrize" data-id="{{item.id}}" disabled="{{lotteryBusy || lotteryStatus === 'rolling'}}">重新抽取</button>
            </view>
            <view class="ri-actions">
              <view class="ri-act {{index === 0 ? 'ri-act-disabled' : ''}}" bindtap="movePrize" data-index="{{index}}" data-dir="-1">上移</view>
              <view class="ri-act {{index === lotteryPrizes.length - 1 ? 'ri-act-disabled' : ''}}" bindtap="movePrize" data-index="{{index}}" data-dir="1">下移</view>
              <view class="ri-act" bindtap="openPrizeModal" data-index="{{index}}">编辑</view>
              <view class="ri-act ri-act-danger" bindtap="deletePrize" data-index="{{index}}">删除</view>
            </view>
          </view>
        </view>

        <view wx:if="{{lotteryLoaded && lotteryPrizes.length === 0}}" class="empty-tip record-empty">
          <text>还没有设置奖项，大屏会显示「抽奖尚未设置奖项」</text>
        </view>

        <view class="rc-btn-row">
          <view class="rc-btn rc-btn-gold" bindtap="openPrizeModal">＋ 新增奖项</view>
        </view>
        <view class="rc-btn-row lt-screen-row">
          <view class="rc-btn rc-btn-plain lt-btn-flex {{lotteryStatus === 'rolling' ? 'ri-act-disabled' : ''}}" bindtap="screenIdle">大屏回到等待页</view>
          <view class="rc-btn rc-btn-plain lt-btn-flex {{lotteryStatus === 'rolling' || !lotteryAnyDrawn ? 'ri-act-disabled' : ''}}" bindtap="screenBoard">大屏展示中奖名单</view>
        </view>
        <text class="col-tip">一个奖项揭晓后，直接点下一个奖项的「开始抽奖」即可。</text>
      </view>

      <!-- 全部揭晓：中奖总榜 -->
      <view class="card record-card" wx:if="{{lotteryAllDrawn}}">
        <view class="rc-head">
          <text class="ug-title rc-title">中奖总榜</text>
          <text class="rc-status rc-status-ok">全部奖项已揭晓</text>
        </view>
        <view wx:for="{{lotteryPrizes}}" wx:key="id" class="lt-board-row">
          <view class="lt-board-h"><text class="lt-board-n">{{item.label}}</text><text class="lt-board-r" wx:if="{{item.sub}}">{{item.sub}}</text></view>
          <text class="lt-board-w">{{item.winnersText || '—'}}</text>
        </view>
        <button class="btn-gold rc-save-btn" bindtap="screenBoard" disabled="{{lotteryBusy}}">在大屏展示中奖总榜</button>
      </view>

      <!-- 参与名单 -->
      <view class="card record-card">
        <view class="rc-head">
          <text class="ug-title rc-title">参与名单</text>
          <text class="rc-status {{lotteryParticipants.length ? 'rc-status-ok' : ''}}">共 {{lotteryParticipants.length}} 人</text>
        </view>
        <text class="ug-desc rc-desc">默认从宾客回执导入「确认出席」的宾客（按姓名去重），也可以手动添加。点名字可移出名单。</text>
        <view class="lt-chips" wx:if="{{lotteryParticipants.length}}">
          <view wx:for="{{lotteryParticipants}}" wx:key="id" class="lt-chip" bindtap="removeParticipant" data-id="{{item.id}}">
            <text>{{item.name}}</text><text class="lt-chip-x">×</text>
          </view>
        </view>
        <view wx:if="{{lotteryLoaded && lotteryParticipants.length === 0}}" class="empty-tip record-empty">
          <text>名单为空，暂时无法开始抽奖</text>
        </view>
        <button class="btn-primary rc-save-btn" bindtap="importLotteryRsvp" loading="{{lotteryBusy}}">从回执名单导入出席宾客</button>
        <view class="rc-btn-row" style="margin-top: 16rpx;">
          <view class="rc-btn rc-btn-gold" bindtap="openParticipantModal">＋ 手动添加</view>
          <view class="rc-btn rc-btn-plain lt-btn-flex {{lotteryParticipants.length ? '' : 'ri-act-disabled'}}" bindtap="clearParticipants">清空名单</view>
        </view>
      </view>

      <!-- 重置 -->
      <view class="card record-card">
        <text class="nsc-title rc-title">重置本场抽奖</text>
        <text class="ug-desc rc-desc">清空所有中奖结果、大屏回到等待页；奖项和参与名单保留。</text>
        <button class="lt-reset-btn" bindtap="resetLotteryAll" disabled="{{lotteryBusy}}">重置本场抽奖</button>
      </view>
    </view>
  </block>

  <!-- 抽奖奖项编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showPrizeModal}}">
    <view class="modal-card">
      <view class="modal-title">{{prizeEditIndex >= 0 ? '编辑奖项' : '新增奖项'}}</view>
      <view class="modal-subtitle">奖项名称和奖品内容至少填一项，点「确定」即保存</view>
      <view class="modal-form-item">
        <text class="mf-label">奖项名称</text>
        <input class="mf-input" placeholder="如 一等奖 / 幸运奖" value="{{prizeForm.name}}" bindinput="onPrizeInput" data-field="name" maxlength="40" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">奖品内容（金额或礼物）</text>
        <input class="mf-input" placeholder="如 888元红包 / 纪念礼盒" value="{{prizeForm.reward}}" bindinput="onPrizeInput" data-field="reward" maxlength="60" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">中奖人数</text>
        <input class="mf-input" type="number" placeholder="如 3" value="{{prizeForm.count}}" bindinput="onPrizeInput" data-field="count" maxlength="3" />
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn-cancel" bindtap="closePrizeModal">取消</button>
        <button class="modal-btn-confirm" bindtap="confirmPrize">确定</button>
      </view>
    </view>
  </view>

  <!-- 手动添加参与人弹窗 -->
  <view class="modal-mask" wx:if="{{showParticipantModal}}">
    <view class="modal-card">
      <view class="modal-title">手动添加参与人</view>
      <view class="modal-subtitle">每行一个名字，也可以用逗号、顿号分隔；重名会自动跳过</view>
      <view class="modal-form-item">
        <textarea class="mf-textarea" fixed="{{true}}" maxlength="4000" placeholder="如：张三、李四、王五" value="{{participantInput}}" bindinput="onParticipantInput"></textarea>
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn-cancel" bindtap="closeParticipantModal">取消</button>
        <button class="modal-btn-confirm" bindtap="confirmParticipants">添加</button>
      </view>
    </view>
  </view>

  <!-- 岁月印记编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showStoryModal}}">
    <view class="modal-card">
      <view class="modal-title">{{storyEditIndex >= 0 ? '编辑纪事' : '新增纪事'}}</view>
      <view class="modal-subtitle">填写后点「确定」，再点列表下方「保存岁月印记」才会同步给宾客</view>

      <view class="modal-form-item">
        <text class="mf-label">日期</text>
        <input class="mf-input" placeholder="如 2022.05.20" value="{{storyForm.date}}" bindinput="onStoryInput" data-field="date" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">标题</text>
        <input class="mf-input" placeholder="如 初遇 · 心动的序章" value="{{storyForm.title}}" bindinput="onStoryInput" data-field="title" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">内容</text>
        <textarea class="mf-textarea" fixed="{{true}}" maxlength="500" placeholder="写下这段故事" value="{{storyForm.content}}" bindinput="onStoryInput" data-field="content"></textarea>
      </view>
      <view class="modal-form-item">
        <text class="mf-label">配图（可选）</text>
        <video wx:if="{{storyForm.image && storyForm.isVideo}}" class="sf-preview" src="{{storyForm.image}}" object-fit="cover" controls="{{true}}" show-center-play-btn="{{true}}"></video>
        <image wx:elif="{{storyForm.image}}" class="sf-preview" src="{{storyForm.image}}" mode="aspectFill"></image>
        <view wx:else class="sf-preview sf-preview-empty"><text>暂无配图</text></view>
        <view class="rc-btn-row sf-btn-row">
          <view class="rc-btn rc-btn-gold" bindtap="toggleStoryPhotoPicker">{{showStoryPhotoPicker ? '收起相册' : '从相册选'}}</view>
          <view class="rc-btn rc-btn-gold {{uploadingStoryImage ? 'ri-act-disabled' : ''}}" bindtap="uploadStoryImage">{{uploadingStoryImage ? '上传中…' : (canUploadVideo ? '上传图片或视频' : '上传图片')}}</view>
          <view class="rc-btn rc-btn-plain" wx:if="{{storyForm.image}}" bindtap="clearStoryImage">移除</view>
        </view>
        <text class="sf-hint">在这里上传的内容仅用于纪事。</text>
        <view class="sf-picker" wx:if="{{showStoryPhotoPicker}}">
          <view
            wx:for="{{photosList}}"
            wx:key="url"
            class="sf-pick-wrap"
            bindtap="pickStoryPhoto"
            data-url="{{item.url}}"
            data-kind="{{item.kind}}"
          >
            <image
              class="sf-pick-img {{storyForm.image === item.url ? 'sf-pick-active' : ''}}"
              src="{{item.thumb_url || item.thumbUrl || item.url}}"
              mode="aspectFill"
            ></image>
            <view class="sf-pick-play" wx:if="{{item.isVideo || item.kind === 'video'}}">▶</view>
          </view>
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="modal-btn-cancel" bindtap="closeStoryModal">取消</button>
        <button class="modal-btn-confirm" bindtap="confirmStoryItem">确定</button>
      </view>
    </view>
  </view>

  <!-- 当日行程编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showScheduleModal}}">
    <view class="modal-card">
      <view class="modal-title">{{scheduleEditIndex >= 0 ? '编辑行程' : '新增行程'}}</view>
      <view class="modal-subtitle">填写后点「确定」，再点「保存当日行程」才会同步给宾客</view>

      <view class="modal-form-item">
        <text class="mf-label">时间</text>
        <input class="mf-input" placeholder="如 11:58" value="{{scheduleForm.time}}" bindinput="onScheduleInput" data-field="time" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">环节名称 *</text>
        <input class="mf-input" placeholder="如 神圣仪式·执手此生" value="{{scheduleForm.title}}" bindinput="onScheduleInput" data-field="title" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">说明</text>
        <textarea class="mf-textarea" fixed="{{true}}" maxlength="200" placeholder="如 新郎新娘步入殿堂，交换婚戒与神圣誓言" value="{{scheduleForm.desc}}" bindinput="onScheduleInput" data-field="desc"></textarea>
      </view>

      <view class="modal-btn-row">
        <button class="modal-btn-cancel" bindtap="closeScheduleModal">取消</button>
        <button class="modal-btn-confirm" bindtap="confirmScheduleItem">确定</button>
      </view>
    </view>
  </view>

  <!-- 新建婚礼弹窗 -->
  <view class="modal-mask" wx:if="{{showNewWeddingModal}}">
    <view class="modal-card">
      <view class="modal-title">创建新婚礼档期</view>
      <view class="modal-subtitle">在 Cloudflare 数据库中建立新人的专属请柬档案</view>
      
      <view class="modal-form-item">
        <text class="mf-tip">婚礼标识会自动生成（随机且不重复），不用再填新郎拼音。</text>
      </view>
      <view class="modal-form-row">
        <view class="modal-form-item" style="flex: 1; margin-right: 12rpx;">
          <text class="mf-label">新郎姓名 *</text>
          <input class="mf-input" placeholder="新郎名字" value="{{newWeddingForm.groomName}}" bindinput="onNewWeddingInput" data-field="groomName" />
        </view>
        <view class="modal-form-item" style="flex: 1; margin-left: 12rpx;">
          <text class="mf-label">新娘姓名 *</text>
          <input class="mf-input" placeholder="新娘名字" value="{{newWeddingForm.brideName}}" bindinput="onNewWeddingInput" data-field="brideName" />
        </view>
      </view>
      <view class="modal-form-row">
        <view class="modal-form-item" style="flex: 1; margin-right: 12rpx;">
          <text class="mf-label">婚礼吉日</text>
          <input class="mf-input" placeholder="如 2026年10月18日" value="{{newWeddingForm.date}}" bindinput="onNewWeddingInput" data-field="date" />
        </view>
        <view class="modal-form-item" style="flex: 1; margin-left: 12rpx;">
          <text class="mf-label">吉时</text>
          <input class="mf-input" placeholder="如 11:58" value="{{newWeddingForm.time}}" bindinput="onNewWeddingInput" data-field="time" />
        </view>
      </view>
      <view class="modal-form-item">
        <text class="mf-label">宴席酒店/华堂</text>
        <input class="mf-input" placeholder="如 静安瑞吉酒店 · 阿斯特宴会厅" value="{{newWeddingForm.venueName}}" bindinput="onNewWeddingInput" data-field="venueName" />
      </view>
      <view class="modal-form-item">
        <text class="mf-label">详细地址</text>
        <input class="mf-input" placeholder="酒店详细地址" value="{{newWeddingForm.venueAddress}}" bindinput="onNewWeddingInput" data-field="venueAddress" />
      </view>

      <view class="modal-btn-row">
        <button class="modal-btn-cancel" bindtap="closeNewWeddingModal">取消</button>
        <button class="modal-btn-confirm" bindtap="submitNewWedding" loading="{{submittingNewWedding}}">创建并保存</button>
      </view>
    </view>
  </view>
</view>

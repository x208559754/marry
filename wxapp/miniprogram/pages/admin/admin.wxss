  border: 1rpx solid rgba(197, 160, 89, 0.45);
}

button.lt-ctrl[disabled] {
  opacity: 0.5;
}

.lt-screen-row {
  margin-top: 16rpx;
}

.rc-btn-plain.lt-btn-flex {
  flex: 1;
}

.lt-board-row {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E2D9CC;
}

.lt-board-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.lt-board-n {
  font-size: 26rpx;
  font-weight: bold;
  color: #8B1E1E;
}

.lt-board-r {
  font-size: 22rpx;

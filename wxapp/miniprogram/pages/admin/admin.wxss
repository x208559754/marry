  background: #EEF7F0;
}

.lt-tag-live {
  color: #B23A3A;
  background: #FFF3F0;
}

.lt-winners {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-main);
}

.lt-winners-wait {
  color: #B23A3A;
}

.lt-w-label {
  color: #8B1E1E;

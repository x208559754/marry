}

.info-map-btn {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 22rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6D4E1E;
  background: linear-gradient(135deg, #F6E7C1 0%, #E8D5A3 100%);
  border: 1rpx solid rgba(197, 160, 89, 0.45);

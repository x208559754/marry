}

/* ================= 现场抽奖 ================= */
.tab-segment-4 .tab-item {
  font-size: 22rpx;
  white-space: nowrap;
  padding: 16rpx 4rpx;
}

.lt-url {
  font-size: 24rpx;
  line-height: 1.5;
  color: #6D4E1E;
  word-break: break-all;
  background: #FFFDF8;
  border: 1rpx solid #E6CA65;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.lt-prize-on {
  border-color: #B23A3A;
  box-shadow: 0 0 0 2rpx rgba(178, 58, 58, 0.12);
}

.lt-count {
  min-width: 96rpx;
}

.lt-tag {

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // D1 数据库绑定：运行 `npm run db:create` 后，
  // 把输出的 database_id 填到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marry-images",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
